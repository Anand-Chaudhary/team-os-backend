generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  SUPER_ADMIN
  LEADER
  MANAGER
  EXECUTIVE
  SALES
  CLIENT // client-side portal user
}

enum AccountStatus {
  PENDING     // awaiting admin approval (join request)
  ACTIVE
  DEACTIVATED
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  phone         String?
  passwordHash  String
  role          StaffRole
  status        AccountStatus @default(PENDING)

  // Attendance config (module 3) — per-employee overrides
  jobType           String?
  reportTime        String?   // e.g. "10:00" — stored as string, interpreted in org timezone
  gracePeriodMins   Int?      @default(15)

  // Relations: staff side
  clientProfile     Client?          @relation("ClientPOC")
  clientContactOf   Client?          @relation("ClientContact", fields: [clientContactId], references: [id])
  clientContactId   String?

  tasksAssigned     TaskAssignee[]
  tasksCreated      Task[]           @relation("TaskCreatedBy")
  taskRevisions     TaskRevision[]   @relation("TaskRevisionBy")

  shoots            ShootCrew[]
  punches           Punch[]          @relation("PunchOwner")
  leaveRequests     LeaveRequest[]   @relation("LeaveRequestedBy")
  leaveReviews      LeaveRequest[]   @relation("LeaveReviewedBy")

  leadsAssigned     Lead[]           @relation("LeadAssignedTo")
  financeEntries    FinanceEntry[]   @relation("FinanceEnteredBy")

  clientRequestsMade      ClientRequest[] @relation("ClientRequestBy")
  clientRequestsAssigned  ClientRequest[] @relation("ClientRequestAssignee")

  calendarPostsApproved   CalendarPost[]  @relation("PostApprovedBy")

  notifications     Notification[]
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]
  joinRequestReview JoinRequest[]    @relation("JoinRequestReviewedBy")
  punchApprovals    Punch[]          @relation("PunchApprovedBy")
  permissionOverrides PermissionOverride[]

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([role])
  @@index([status])
}

// New staff registering and awaiting admin approval, before a User row exists
model JoinRequest {
  id          String        @id @default(cuid())
  name        String
  email       String        @unique
  phone       String?
  requestedRole StaffRole
  status      AccountStatus @default(PENDING)
  reviewedBy  User?         @relation("JoinRequestReviewedBy", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt  DateTime?
  createdAt   DateTime      @default(now())
}

model RefreshToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PermissionOverride {
  id       String   @id @default(cuid())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  module   String   // e.g. "finance", "leads", "clients"
  canView  Boolean  @default(false)
  canEdit  Boolean  @default(false)

  @@unique([userId, module])
}

enum PunchStatus {
  ON_TIME
  LATE
  FLAGGED       // outside geofence, pending manager approval
  APPROVED
  REJECTED
}

model OfficeLocation {
  id        String   @id @default(cuid())
  name      String
  latitude  Float
  longitude Float
  radiusM   Int      @default(150) // geofence radius in meters
  punches   Punch[]
}

model Punch {
  id           String        @id @default(cuid())
  user         User          @relation("PunchOwner", fields: [userId], references: [id])
  userId       String
  office       OfficeLocation? @relation(fields: [officeId], references: [id])
  officeId     String?

  checkIn      DateTime
  checkOut     DateTime?
  checkInLat   Float?
  checkInLng   Float?
  distanceM    Float?        // distance from office at check-in
  status       PunchStatus   @default(ON_TIME)

  approvedBy   User?         @relation("PunchApprovedBy", fields: [approvedById], references: [id])
  approvedById String?

  lunchBreaks  LunchBreak[]

  createdAt    DateTime      @default(now())

  @@index([userId, checkIn])
  @@index([status])
}

model LunchBreak {
  id      String    @id @default(cuid())
  punch   Punch     @relation(fields: [punchId], references: [id], onDelete: Cascade)
  punchId String
  start   DateTime
  end     DateTime?
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id            String      @id @default(cuid())
  user          User        @relation("LeaveRequestedBy", fields: [userId], references: [id])
  userId        String
  startDate     DateTime
  endDate       DateTime
  reason        String
  status        LeaveStatus @default(PENDING)
  reviewedBy    User?       @relation("LeaveReviewedBy", fields: [reviewedById], references: [id])
  reviewedById  String?
  createdAt     DateTime    @default(now())

  @@index([userId, status])
}

enum TaskStatus {
  PLANNED
  IN_PROGRESS
  SUBMITTED
  INTERNAL_QC
  APPROVED
  REVISION
  POSTED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT // auto-escalated as deadline approaches
}

model Task {
  id          String         @id @default(cuid())
  title       String
  description String?
  client      Client?        @relation(fields: [clientId], references: [id])
  clientId    String?

  status      TaskStatus     @default(PLANNED)
  priority    TaskPriority   @default(MEDIUM)
  deadline    DateTime?

  createdBy   User           @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdById String

  assignees   TaskAssignee[]
  revisions   TaskRevision[]
  calendarPost CalendarPost?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([clientId])
  @@index([deadline])
}

// Many-to-many: a task can have multiple assignees
model TaskAssignee {
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId   String
  user     User    @relation(fields: [userId], references: [id])
  userId   String

  @@id([taskId, userId])
}

// Revision history log — one row per round
model TaskRevision {
  id           String   @id @default(cuid())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId       String
  roundNumber  Int
  note         String
  attachmentUrl String?
  submittedBy  User     @relation("TaskRevisionBy", fields: [submittedById], references: [id])
  submittedById String
  createdAt    DateTime @default(now())

  @@index([taskId])
}

model Shoot {
  id            String       @id @default(cuid())
  client        Client?      @relation(fields: [clientId], references: [id])
  clientId      String?
  title         String
  scheduledAt   DateTime
  location      String?
  cost          Decimal?     @db.Decimal(10, 2)

  crew          ShootCrew[]
  gearChecklist GearItem[]

  createdAt     DateTime     @default(now())

  @@index([scheduledAt])
}

model ShootCrew {
  shoot   Shoot  @relation(fields: [shootId], references: [id], onDelete: Cascade)
  shootId String
  user    User   @relation(fields: [userId], references: [id])
  userId  String
  role    String? // e.g. "Photographer", "Assistant"

  @@id([shootId, userId])
}

model GearItem {
  id       String  @id @default(cuid())
  shoot    Shoot   @relation(fields: [shootId], references: [id], onDelete: Cascade)
  shootId  String
  name     String
  packed   Boolean @default(false)
}

model Client {
  id               String    @id @default(cuid())
  name             String    // brand name
  contactEmail     String?
  contactPhone     String?
  whatsappGroupUrl String?
  contentTags      String[]  // e.g. ["Reels", "Static Posts", "Blogs"]
  monthlyGoal      Int?      // target posts/month

  poc              User?     @relation("ClientPOC", fields: [pocId], references: [id])
  pocId            String?   @unique

  contacts         User[]    @relation("ClientContact") // client-side portal logins
  tasks            Task[]
  shoots           Shoot[]
  calendarPosts    CalendarPost[]
  requests         ClientRequest[]
  shareLink        ShareLink?
  financeEntries   FinanceEntry[]

  createdAt        DateTime  @default(now())

  @@index([name])
}

// Tokenized, read-only public calendar link — no login required
model ShareLink {
  id        String   @id @default(cuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String   @unique
  token     String   @unique @default(cuid())
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

enum PostApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
  REJECTED
}

model CalendarPost {
  id             String              @id @default(cuid())
  client         Client              @relation(fields: [clientId], references: [id])
  clientId       String
  task           Task?               @relation(fields: [taskId], references: [id])
  taskId         String?             @unique

  caption        String?
  postType       String              // e.g. "Reel", "Carousel", "Story"
  scheduledDate  DateTime
  approvalStatus PostApprovalStatus  @default(DRAFT)
  revisionReason String?
  posted         Boolean             @default(false)
  postedAt       DateTime?

  approvedBy     User?               @relation("PostApprovedBy", fields: [approvedById], references: [id])
  approvedById   String?

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([clientId, scheduledDate])
  @@index([approvalStatus])
}

// Ad-hoc requests submitted by a client contact through the portal
enum ClientRequestStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model ClientRequest {
  id           String              @id @default(cuid())
  client       Client              @relation(fields: [clientId], references: [id])
  clientId     String
  requestedBy  User                @relation("ClientRequestBy", fields: [requestedById], references: [id])
  requestedById String
  message      String
  assignee     User?               @relation("ClientRequestAssignee", fields: [assigneeId], references: [id])
  assigneeId   String?
  deadline     DateTime?
  status       ClientRequestStatus @default(OPEN)
  createdAt    DateTime            @default(now())

  @@index([clientId, status])
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

model Lead {
  id           String    @id @default(cuid())
  name         String
  contactEmail String?
  contactPhone String?
  source       String?
  stage        LeadStage @default(NEW)

  assignedTo   User?     @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  assignedToId String?

  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([stage])
  @@index([assignedToId])
}

enum FinanceType {
  INCOME
  EXPENSE
}

model FinanceEntry {
  id          String      @id @default(cuid())
  type        FinanceType
  category    String      // e.g. "Retainer", "Equipment", "Salary"
  amount      Decimal     @db.Decimal(12, 2)
  month       DateTime    // first-of-month marker for grouping
  client      Client?     @relation(fields: [clientId], references: [id])
  clientId    String?
  isInternal  Boolean     @default(false)
  note        String?

  enteredBy   User        @relation("FinanceEnteredBy", fields: [enteredById], references: [id])
  enteredById String

  createdAt   DateTime    @default(now())

  @@index([month])
  @@index([clientId])
}

model Notification {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  title         String
  message       String
  link          String?  // in-app deep link
  whatsappLink  String?  // optional WhatsApp handoff
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, read])
}

model AuditLog {
  id           String   @id @default(cuid())
  entityType   String   // e.g. "Task", "User", "PermissionOverride"
  entityId     String
  action       String   // e.g. "APPROVE", "DELETE", "PERMISSION_CHANGE"
  performedBy  User?    @relation(fields: [performedById], references: [id])
  performedById String?
  before       Json?
  after        Json?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}